<xr-scene id="companion-scene" bind:ready="handleReady" bind:error="handleError" bind:tick="handleTick">
  <xr-assets bind:progress="handleAssetsProgress" bind:loaded="handleAssetsLoaded">
    <xr-asset-material asset-id="avatar-mat" effect="standard" uniforms="u_baseColorFactor:1 1 1 1" />
    <xr-asset-material asset-id="body-mat" effect="standard" uniforms="u_baseColorFactor:0.20 0.34 0.78 1" />
    <xr-asset-material asset-id="body-light-mat" effect="standard" uniforms="u_baseColorFactor:0.42 0.70 1 1" />
    <xr-asset-material asset-id="accent-mat" effect="standard" uniforms="u_baseColorFactor:0.98 0.66 0.35 1" />
    <xr-asset-material asset-id="glow-mat" effect="standard" uniforms="u_baseColorFactor:0.47 0.43 1 1" />
    <xr-asset-material asset-id="dark-mat" effect="standard" uniforms="u_baseColorFactor:0.025 0.04 0.11 1" />
  </xr-assets>

  <xr-node>
    <xr-node node-id="camera-target" position="0 0.15 -4"></xr-node>
    <xr-node node-id="avatar-root" position="0 0.08 -4">
      <xr-mesh id="avatar-body" node-id="avatar-body" position="0 -0.52 0" scale="0.72 0.86 0.50" geometry="cylinder" material="body-mat" cast-shadow receive-shadow />
      <xr-mesh id="avatar-chest" node-id="avatar-chest" position="0 -0.25 -0.47" scale="0.30 0.22 0.06" geometry="sphere" material="glow-mat" />
      <xr-mesh id="avatar-head" node-id="avatar-head" position="0 0.56 0" scale="0.72 0.72 0.72" geometry="sphere" material="body-light-mat" cast-shadow receive-shadow />
      <xr-mesh id="avatar-portrait" node-id="avatar-portrait" position="0 0.57 0.64" scale="0.38 0.49 0.38" geometry="plane" material="avatar-mat" visible="{{avatarTextureReady}}" />
      <xr-mesh node-id="left-ear" position="-0.69 0.57 0" scale="0.18 0.25 0.18" geometry="sphere" material="body-light-mat" />
      <xr-mesh node-id="right-ear" position="0.69 0.57 0" scale="0.18 0.25 0.18" geometry="sphere" material="body-light-mat" />
      <xr-mesh node-id="left-eye" position="-0.25 0.66 0.65" scale="0.10 0.14 0.06" geometry="sphere" material="dark-mat" />
      <xr-mesh node-id="right-eye" position="0.25 0.66 0.65" scale="0.10 0.14 0.06" geometry="sphere" material="dark-mat" />
      <xr-mesh node-id="left-eye-glint" position="-0.22 0.71 0.70" scale="0.025 0.035 0.02" geometry="sphere" material="accent-mat" />
      <xr-mesh node-id="right-eye-glint" position="0.28 0.71 0.70" scale="0.025 0.035 0.02" geometry="sphere" material="accent-mat" />
      <xr-mesh node-id="left-arm" position="-0.82 -0.45 0" rotation="0 0 -18" scale="0.16 0.54 0.16" geometry="cylinder" material="body-light-mat" />
      <xr-mesh node-id="right-arm" position="0.82 -0.45 0" rotation="0 0 18" scale="0.16 0.54 0.16" geometry="cylinder" material="body-light-mat" />
      <xr-mesh node-id="left-hand" position="-0.99 -0.91 0" scale="0.18 0.18 0.18" geometry="sphere" material="accent-mat" />
      <xr-mesh node-id="right-hand" position="0.99 -0.91 0" scale="0.18 0.18 0.18" geometry="sphere" material="accent-mat" />
      <xr-mesh node-id="halo" position="0 1.18 0" rotation="70 0 0" scale="0.92 0.07 0.92" geometry="cylinder" material="glow-mat" />
      <xr-mesh node-id="halo-core" position="0 1.18 0" rotation="70 0 0" scale="0.67 0.025 0.67" geometry="cylinder" material="accent-mat" />
    </xr-node>

    <xr-mesh node-id="planet-large" position="-1.55 -1.15 -4.4" scale="0.36 0.36 0.36" geometry="sphere" material="accent-mat" cast-shadow />
    <xr-mesh node-id="planet-large-ring" position="-1.55 -1.15 -4.4" rotation="68 0 0" scale="0.58 0.045 0.58" geometry="cylinder" material="glow-mat" />
    <xr-mesh node-id="planet-small" position="1.68 0.92 -4.8" scale="0.18 0.18 0.18" geometry="sphere" material="body-light-mat" />
    <xr-mesh node-id="planet-small-ring" position="1.68 0.92 -4.8" rotation="70 0 0" scale="0.30 0.025 0.30" geometry="cylinder" material="accent-mat" />
    <xr-mesh node-id="floor" position="0 -1.42 -4" scale="3.7 0.02 1.7" geometry="plane" material="dark-mat" />

    <xr-camera id="camera" node-id="camera" position="0 0.45 1.65" clear-color="0.025 0.04 0.11 1" target="camera-target" camera-orbit-control="" />
  </xr-node>

  <xr-node node-id="lights">
    <xr-light type="ambient" color="0.55 0.62 1" intensity="1.3" />
    <xr-light type="directional" rotation="30 150 0" color="0.70 0.84 1" intensity="3.2" cast-shadow />
    <xr-light type="point" position="0 1.8 0.8" color="0.55 0.45 1" intensity="4" range="8" />
  </xr-node>
</xr-scene>
