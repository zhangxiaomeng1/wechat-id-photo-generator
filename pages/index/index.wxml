<view class="page">
  <view class="hero">
    <view class="hero-orbit orbit-large"></view>
    <view class="hero-orbit orbit-small"></view>
    <view class="nav"><view class="brand">XM<text>.</text></view><view class="nav-status"><text class="status-dot"></text> ID PHOTO STUDIO</view></view>
    <view class="hero-copy">
      <view class="eyebrow"><text class="eyebrow-line"></text> QUICK PHOTO TOOL</view>
      <view class="title">一张照片，<text>生成标准证件照。</text></view>
    <view class="subtitle">上传照片，选择尺寸，快速导出一寸、二寸证件照。</view>
    </view>
    <view class="hero-foot"><text>LOCAL PROCESSING</text><text>01 / 03</text></view>
  </view>

  <view class="workspace">
    <view class="section-label">01 / UPLOAD PHOTO</view>
    <view class="upload-card" bindtap="choosePhoto">
      <image wx:if="{{photoPath}}" class="source-image" src="{{photoPath}}" mode="aspectFill"></image>
      <view wx:else class="upload-empty"><view class="upload-icon">＋</view><text class="upload-title">上传一张正面照片</text><text class="upload-hint">支持从相册选择，或直接拍摄</text></view>
      <view wx:if="{{photoPath}}" class="change-photo">重新选择</view>
    </view>

    <view class="section-label spacing-top">02 / SELECT SIZE</view>
    <view class="size-grid">
      <view wx:for="{{photoSpecs}}" wx:key="key" class="size-card {{selectedSize === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectSize">
        <view class="size-check">{{selectedSize === item.key ? '✓' : ''}}</view>
        <view class="size-name">{{item.label}}</view>
        <view class="size-detail">{{item.size}}</view>
        <view class="size-pixel">{{item.pixelWidth}} × {{item.pixelHeight}} px</view>
      </view>
    </view>

    <view class="section-label spacing-top">03 / EXPORT</view>
    <button class="generate-button" loading="{{isGenerating}}" bindtap="generatePhoto">{{isGenerating ? '正在生成…' : '生成证件照'}} <text>↗</text></button>

    <view class="result-card" wx:if="{{resultPath}}">
      <view class="result-heading"><view><view class="section-label">RESULT / READY</view><view class="result-title">你的证件照</view></view><view class="result-badge">{{selectedSize === 'one' ? '一寸' : '二寸'}}</view></view>
      <image class="result-image" src="{{resultPath}}" mode="widthFix"></image>
      <button class="save-button" bindtap="savePhoto">保存到相册</button>
    </view>

    <canvas id="idPhotoCanvas" type="2d" class="photo-canvas"></canvas>

    <view class="note-card"><text class="note-mark">✳</text><view><text class="note-title">关于生成效果</text><text class="note-copy">当前版本在本地完成裁剪、白底排版和导出，不会上传原图。自动抠图换蓝/红底需要后续接入图像处理服务。</text></view></view>
  </view>

  <view class="footer"><view class="brand">XM<text>.</text></view><text>MAKE IT USEFUL.</text></view>
</view>
