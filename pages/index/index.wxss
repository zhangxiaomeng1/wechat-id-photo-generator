.page { min-height: 100vh; background: #f4f5f3; color: #10151a; }
.hero { position: relative; min-height: 560rpx; padding: 46rpx 48rpx 38rpx; overflow: hidden; background: #0c1116; color: #f8faf7; display: flex; flex-direction: column; justify-content: space-between; }
.hero-orbit { position: absolute; border: 1rpx solid rgba(218,245,53,.22); border-radius: 50%; pointer-events: none; }
.orbit-large { width: 640rpx; height: 640rpx; right: -350rpx; top: 84rpx; }
.orbit-small { width: 390rpx; height: 390rpx; right: -190rpx; top: 212rpx; border-color: rgba(218,245,53,.45); }
.nav, .hero-foot { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; }
.brand { font-size: 44rpx; line-height: 1; font-weight: 800; letter-spacing: -3rpx; }
.brand text { color: #dafa35; }
.nav-status, .hero-foot { color: #89929b; font-size: 17rpx; letter-spacing: 2rpx; }
.status-dot { display: inline-block; width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: #dafa35; box-shadow: 0 0 18rpx #dafa35; }
.hero-copy { position: relative; z-index: 1; margin-top: 74rpx; }
.eyebrow, .section-label { color: #8a949e; font-size: 19rpx; letter-spacing: 3rpx; line-height: 1.4; }
.eyebrow { color: #dafa35; display: flex; align-items: center; gap: 12rpx; }
.eyebrow-line { width: 45rpx; height: 2rpx; background: #dafa35; }
.title { margin-top: 30rpx; font-size: 68rpx; line-height: 1.17; font-weight: 700; letter-spacing: -3rpx; }
.title text { display: block; color: #dafa35; }
.subtitle { max-width: 600rpx; margin-top: 28rpx; color: #a7b0b8; font-size: 25rpx; line-height: 1.75; }
.hero-foot { color: #66717c; }
.workspace { padding: 74rpx 42rpx 90rpx; }
.spacing-top { margin-top: 58rpx; }
.upload-card { position: relative; min-height: 350rpx; margin-top: 22rpx; border: 2rpx dashed #c5cbc7; background: #fff; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.upload-empty { display: flex; align-items: center; flex-direction: column; }
.upload-icon { width: 80rpx; height: 80rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #dafa35; color: #10151a; font-size: 46rpx; line-height: 1; }
.upload-title { margin-top: 22rpx; font-size: 30rpx; font-weight: 700; }
.upload-hint { margin-top: 12rpx; color: #8a949e; font-size: 22rpx; }
.source-image { width: 100%; height: 350rpx; }
.change-photo { position: absolute; right: 20rpx; bottom: 20rpx; padding: 12rpx 18rpx; color: #10151a; background: #dafa35; font-size: 21rpx; }
.size-grid { display: flex; gap: 18rpx; margin-top: 22rpx; }
.size-card { position: relative; flex: 1; min-height: 192rpx; padding: 26rpx 22rpx; border: 1rpx solid #d7dcd8; background: #fff; }
.size-card.active { border-color: #10151a; box-shadow: inset 0 0 0 2rpx #10151a; }
.size-check { position: absolute; top: 18rpx; right: 18rpx; width: 28rpx; height: 28rpx; border-radius: 50%; color: #10151a; background: #dafa35; font-size: 20rpx; text-align: center; line-height: 28rpx; }
.size-name { margin-top: 24rpx; font-size: 34rpx; font-weight: 700; }
.size-detail { margin-top: 12rpx; color: #4f5962; font-size: 22rpx; }
.size-pixel { margin-top: 18rpx; color: #929ba3; font-size: 18rpx; }
.background-row { display: flex; gap: 16rpx; margin-top: 22rpx; }
.background-option { flex: 1; height: 74rpx; padding: 0 16rpx; border: 1rpx solid #d7dcd8; background: #fff; display: flex; align-items: center; gap: 12rpx; color: #5e6871; font-size: 22rpx; }
.background-option.active { border-color: #10151a; color: #10151a; }
.color-dot { width: 28rpx; height: 28rpx; border: 1rpx solid #d0d4d1; border-radius: 50%; }
.background-check { margin-left: auto; color: #10151a; font-size: 24rpx; }
.generate-button, .save-button { height: 92rpx; margin: 54rpx 0 0; border-radius: 0; display: flex; align-items: center; justify-content: center; font-size: 27rpx; font-weight: 700; }
.generate-button { color: #10151a; background: #dafa35; }
.generate-button text { margin-left: 20rpx; font-size: 34rpx; }
.result-card { margin-top: 62rpx; padding: 30rpx; background: #10151a; color: #f8faf7; }
.result-heading { display: flex; justify-content: space-between; align-items: flex-start; }
.result-title { margin-top: 14rpx; font-size: 36rpx; font-weight: 700; }
.result-badge { padding: 10rpx 16rpx; color: #10151a; background: #dafa35; font-size: 21rpx; }
.result-image { display: block; width: 310rpx; margin: 30rpx auto 0; background: #fff; }
.save-button { margin-top: 28rpx; color: #10151a; background: #f8faf7; }
.photo-canvas { position: fixed; left: -10000rpx; top: -10000rpx; width: 360rpx; height: 504rpx; opacity: 0; pointer-events: none; }
.note-card { display: flex; gap: 18rpx; margin-top: 48rpx; padding: 24rpx; border: 1rpx solid #d9dedb; background: #fff; }
.note-mark { color: #e96c4f; font-size: 28rpx; }
.note-title, .note-copy { display: block; }
.note-title { font-size: 22rpx; font-weight: 700; }
.note-copy { margin-top: 8rpx; color: #7b858d; font-size: 21rpx; line-height: 1.65; }
.footer { padding: 30rpx 42rpx 54rpx; display: flex; justify-content: space-between; align-items: center; color: #8b949b; font-size: 17rpx; letter-spacing: 2rpx; }
