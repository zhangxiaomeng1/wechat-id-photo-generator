.page {
  min-height: 100vh;
  background: #f5f5f7;
  color: #1d1d1f;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 44rpx 0;
}

.topbar-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.privacy-pill {
  display: flex;
  align-items: center;
  padding: 12rpx 18rpx;
  border: 1rpx solid #e1e1e6;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .76);
  color: #6e6e73;
  font-size: 20rpx;
}

.privacy-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #34c759;
}

.intro {
  padding: 72rpx 44rpx 54rpx;
}

.intro-kicker,
.result-kicker {
  color: #86868b;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.intro-title {
  margin-top: 24rpx;
  font-size: 66rpx;
  font-weight: 700;
  letter-spacing: -4rpx;
  line-height: 1.16;
}

.intro-title text {
  display: block;
  color: #0071e3;
}

.intro-subtitle {
  max-width: 620rpx;
  margin-top: 26rpx;
  color: #6e6e73;
  font-size: 25rpx;
  line-height: 1.7;
}

.content {
  padding: 0 32rpx 88rpx;
}

.step-heading {
  display: flex;
  align-items: center;
  padding: 0 12rpx;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #1d1d1f;
  color: #fff;
  font-size: 24rpx;
  line-height: 48rpx;
  text-align: center;
}

.step-title {
  font-size: 30rpx;
  font-weight: 700;
}

.step-subtitle {
  margin-top: 6rpx;
  color: #86868b;
  font-size: 21rpx;
}

.upload-card {
  position: relative;
  min-height: 360rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border: 1rpx solid #e1e1e6;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, .05);
}

.upload-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  min-height: 360rpx;
}

.upload-symbol {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #e8f2ff;
  color: #0071e3;
  font-size: 52rpx;
  line-height: 80rpx;
  text-align: center;
}

.upload-title {
  margin-top: 24rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.upload-hint {
  margin-top: 12rpx;
  color: #86868b;
  font-size: 22rpx;
}

.source-image {
  display: block;
  width: 100%;
  height: 360rpx;
}

.image-overlay {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
}

.change-photo {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(29, 29, 31, .78);
  color: #fff;
  font-size: 21rpx;
}

.section-gap {
  margin-top: 56rpx;
}

.size-list {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
}

.size-card {
  position: relative;
  flex: 1;
  padding: 24rpx 22rpx 22rpx;
  border: 1rpx solid #e1e1e6;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .035);
}

.size-card.active {
  border: 2rpx solid #0071e3;
  box-shadow: 0 8rpx 24rpx rgba(0, 113, 227, .12);
}

.size-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.size-name {
  font-size: 34rpx;
  font-weight: 700;
}

.size-check {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #e5e5ea;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

.size-card.active .size-check {
  background: #0071e3;
}

.size-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 116rpx;
  margin-top: 16rpx;
  border-radius: 14rpx;
  background: #f5f5f7;
}

.ratio-shape {
  border: 2rpx solid #c7c7cc;
  background: #fff;
}

.ratio-one {
  width: 48rpx;
  height: 68rpx;
}

.ratio-two {
  width: 54rpx;
  height: 76rpx;
}

.size-detail {
  margin-top: 16rpx;
  color: #6e6e73;
  font-size: 21rpx;
}

.size-pixel {
  margin-top: 8rpx;
  color: #aeaeb2;
  font-size: 18rpx;
}

.export-info {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
}

.export-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #e7f7eb;
  color: #34c759;
  font-size: 24rpx;
  line-height: 42rpx;
  text-align: center;
}

.export-title {
  font-size: 23rpx;
  font-weight: 600;
}

.export-subtitle {
  margin-top: 5rpx;
  color: #86868b;
  font-size: 20rpx;
}

.export-arrow {
  margin-left: auto;
  color: #aeaeb2;
  font-size: 34rpx;
}

.primary-button,
.save-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin: 24rpx 0 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-button {
  background: #0071e3;
  color: #fff;
  box-shadow: 0 12rpx 24rpx rgba(0, 113, 227, .2);
}

.button-arrow {
  margin-left: 18rpx;
  font-size: 38rpx;
  font-weight: 400;
}

.result-card {
  margin-top: 56rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, .06);
}

.result-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.result-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.result-badge {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #e8f2ff;
  color: #0071e3;
  font-size: 21rpx;
}

.result-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #f5f5f7;
}

.result-image {
  display: block;
  width: 300rpx;
  background: #fff;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, .08);
}

.save-button {
  margin-top: 22rpx;
  background: #1d1d1f;
  color: #fff;
}

.photo-canvas {
  position: fixed;
  left: -10000rpx;
  top: -10000rpx;
  width: 360rpx;
  height: 504rpx;
  opacity: 0;
  pointer-events: none;
}

.note-card {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #e9e9ee;
}

.note-icon {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #86868b;
  border-radius: 50%;
  color: #86868b;
  font-size: 21rpx;
  line-height: 29rpx;
  text-align: center;
}

.note-title,
.note-copy {
  display: block;
}

.note-title {
  font-size: 21rpx;
  font-weight: 700;
}

.note-copy {
  margin-top: 8rpx;
  color: #6e6e73;
  font-size: 20rpx;
  line-height: 1.6;
}

.footer {
  display: flex;
  justify-content: space-between;
  padding: 0 44rpx 56rpx;
  color: #aeaeb2;
  font-size: 17rpx;
  letter-spacing: 1.5rpx;
}
