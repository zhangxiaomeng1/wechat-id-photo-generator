.universe-page {
  min-height: 100vh;
  padding: 0 32rpx 76rpx;
  background: #0b1022;
  color: #f7f7fb;
}

.universe-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 12rpx 0;
}

.universe-kicker,
.card-kicker {
  color: #8992b4;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.universe-top-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.local-pill {
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .06);
  color: #b4bbd7;
  font-size: 19rpx;
}

.local-dot,
.online-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #5fe1c1;
}

.universe-intro {
  padding: 56rpx 12rpx 36rpx;
}

.universe-title {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -3rpx;
  line-height: 1.2;
}

.universe-title text {
  display: block;
  color: #a79bff;
}

.universe-subtitle {
  margin-top: 24rpx;
  color: #9da6c7;
  font-size: 24rpx;
  line-height: 1.7;
}

.space-stage {
  position: relative;
  height: 600rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, .11);
  border-radius: 32rpx;
  background: radial-gradient(circle at 50% 38%, #26336b 0, #121a40 42%, #0d132c 100%);
  box-shadow: inset 0 0 80rpx rgba(113, 93, 255, .15), 0 20rpx 50rpx rgba(0, 0, 0, .2);
}

.xr-stage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 32rpx;
}

.xr-stage xr-companion {
  display: block;
  width: 100%;
  height: 100%;
}

.xr-hint {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 999rpx;
  background: rgba(8, 12, 30, .62);
  color: #bfc7e4;
  font-size: 19rpx;
  text-align: center;
}

.xr-avatar-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 999rpx;
  background: rgba(8, 12, 30, .62);
  color: #e6e8f4;
  font-size: 19rpx;
}

.xr-fallback {
  position: absolute;
  top: 108rpx;
  left: 50%;
  width: 360rpx;
  height: 360rpx;
  transform: translateX(-50%);
  text-align: center;
}

.star {
  position: absolute;
  color: #fff;
  opacity: .75;
}

.star-one { top: 78rpx; left: 94rpx; color: #d0c9ff; font-size: 26rpx; }
.star-two { top: 148rpx; right: 120rpx; color: #62e2d0; font-size: 42rpx; }
.star-three { right: 82rpx; bottom: 150rpx; color: #ffc978; font-size: 32rpx; }

.orbit {
  position: absolute;
  border: 1rpx solid rgba(180, 164, 255, .22);
  border-radius: 50%;
  transform: rotate(-18deg);
}

.orbit-one { width: 520rpx; height: 180rpx; top: 182rpx; left: 54rpx; }
.orbit-two { width: 620rpx; height: 230rpx; top: 166rpx; left: 2rpx; border-color: rgba(91, 217, 208, .18); }

.empty-space,
.avatar-scene {
  position: absolute;
  top: 108rpx;
  left: 50%;
  width: 360rpx;
  height: 360rpx;
  transform: translateX(-50%);
  text-align: center;
}

.empty-symbol {
  width: 116rpx;
  height: 116rpx;
  margin: 70rpx auto 0;
  border: 1rpx solid rgba(202, 195, 255, .55);
  border-radius: 50%;
  color: #c9c1ff;
  font-size: 54rpx;
  line-height: 112rpx;
}

.empty-title {
  margin-top: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.empty-subtitle {
  margin-top: 12rpx;
  color: #9da6c7;
  font-size: 21rpx;
}

.avatar-glow,
.avatar-ring,
.avatar-portrait {
  position: absolute;
  top: 34rpx;
  left: 50%;
  width: 280rpx;
  height: 280rpx;
  transform: translateX(-50%);
  border-radius: 50%;
}

.avatar-glow { background: #8b7dff; opacity: .24; filter: blur(34rpx); }
.avatar-ring { border: 2rpx solid #9f93ff; box-shadow: 0 0 0 18rpx rgba(159, 147, 255, .08), 0 0 38rpx rgba(159, 147, 255, .65); }
.avatar-portrait { border: 8rpx solid #fff; object-fit: cover; }

.avatar-tag {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, .18);
  border-radius: 999rpx;
  background: rgba(12, 17, 43, .82);
  color: #fff;
  font-size: 22rpx;
  transform: translateX(-50%);
}

.space-status {
  position: absolute;
  bottom: 26rpx;
  left: 0;
  width: 100%;
  color: #aeb7d5;
  font-size: 19rpx;
  text-align: center;
}

.camera-card,
.create-card,
.companion-card,
.privacy-note {
  margin-top: 22rpx;
  border-radius: 26rpx;
  background: #151d3b;
}

.camera-card { padding: 16rpx; }
.camera-preview { display: block; width: 100%; height: 560rpx; border-radius: 20rpx; background: #050812; }
.camera-tip { padding: 16rpx 0 4rpx; color: #9da6c7; font-size: 20rpx; text-align: center; }
.camera-actions { display: flex; gap: 14rpx; margin-top: 14rpx; }
.camera-actions button { flex: 1; height: 80rpx; border-radius: 16rpx; font-size: 24rpx; }
.camera-close { background: rgba(255, 255, 255, .08); color: #d4d9ed; }
.capture-button { background: #a79bff; color: #14142e; font-weight: 700; }

.create-card,
.companion-card { padding: 28rpx; }

.card-title { margin-top: 12rpx; font-size: 32rpx; font-weight: 700; }
.card-subtitle { margin-top: 8rpx; color: #9da6c7; font-size: 21rpx; }
.create-actions { display: flex; gap: 14rpx; margin-top: 24rpx; }
.create-actions button { flex: 1; height: 84rpx; border-radius: 16rpx; font-size: 23rpx; }
.create-actions text { margin-right: 8rpx; font-size: 30rpx; }
.camera-button { background: #a79bff; color: #14142e; font-weight: 700; }
.album-button { background: rgba(255, 255, 255, .08); color: #f7f7fb; }
.reset-button { height: 70rpx; margin-top: 14rpx; border: 1rpx solid rgba(255, 255, 255, .12); border-radius: 14rpx; background: transparent; color: #9da6c7; font-size: 21rpx; }

.card-header { display: flex; align-items: flex-start; justify-content: space-between; }
.relationship { padding: 8rpx 14rpx; border-radius: 999rpx; background: rgba(95, 225, 193, .12); color: #5fe1c1; font-size: 19rpx; }
.companion-list { width: 100%; margin-top: 24rpx; white-space: nowrap; }
.companion-option { display: inline-block; width: 180rpx; margin-right: 14rpx; padding: 20rpx; border: 1rpx solid rgba(255, 255, 255, .1); border-radius: 18rpx; background: rgba(255, 255, 255, .04); vertical-align: top; }
.companion-option.active { border-color: #a79bff; background: rgba(167, 155, 255, .14); }
.companion-symbol { height: 52rpx; font-size: 42rpx; line-height: 52rpx; }
.companion-name { margin-top: 12rpx; font-size: 24rpx; font-weight: 700; }
.companion-description { margin-top: 6rpx; overflow: hidden; color: #9da6c7; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.companion-message { display: flex; align-items: flex-start; margin-top: 24rpx; padding: 20rpx; border-radius: 18rpx; background: rgba(255, 255, 255, .06); }
.message-avatar { width: 48rpx; height: 48rpx; margin-right: 14rpx; border-radius: 50%; background: #a79bff; color: #1d1944; font-size: 26rpx; line-height: 48rpx; text-align: center; }
.message-name { color: #c8c1ff; font-size: 19rpx; }
.message-text { margin-top: 6rpx; color: #f0f1fa; font-size: 22rpx; line-height: 1.55; }
.mood-row { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.mood-label { color: #9da6c7; font-size: 21rpx; }
.mood-options { display: flex; gap: 8rpx; }
.mood-option { padding: 10rpx 14rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .07); color: #9da6c7; font-size: 19rpx; }
.mood-option.active { background: #a79bff; color: #171433; }
.pulse-actions { display: flex; gap: 10rpx; margin-top: 22rpx; }
.pulse-actions button { flex: 1; height: 72rpx; border-radius: 14rpx; background: rgba(255, 255, 255, .08); color: #e6e8f4; font-size: 20rpx; }
.privacy-note { display: flex; align-items: flex-start; padding: 22rpx; background: rgba(255, 255, 255, .05); }
.privacy-icon { width: 32rpx; height: 32rpx; margin-right: 14rpx; border: 1rpx solid #8992b4; border-radius: 50%; color: #8992b4; font-size: 21rpx; line-height: 29rpx; text-align: center; }
.privacy-title { font-size: 21rpx; font-weight: 700; }
.privacy-copy { margin-top: 7rpx; color: #8992b4; font-size: 19rpx; line-height: 1.55; }
